#data cleaning

df.columns = df.columns.str.strip().str.lower().str.replace (' ', '_')   
df= df.drop_duplicates()

#Numerical columns cleaning

df.price = df.price.astype(str).str.replace(',', '').astype(float)  # Remove $ and , from price and convert to float
df.area = df.area.astype(str).str.replace(',', '').astype(int)  # Remove commas from area and convert to int

df.rate_per_sqft = df.rate_per_sqft.astype(str).str.replace(',', '').astype(int)  # Remove commas from rate_per_sqft and convert to int

#categorical columns cleaning
df.status = df.status.str.strip().str.lower()  # Remove any leading/trailing whitespace from status and convert to lowercase
df["rera_approval"] = df["rera_approval"].str.strip().str.lower().map({"approved": "yes", "not approved": "no"})  # Remove any leading/trailing whitespace from rera_approval and convert to lowercase


#print(df)
#print(df.info())


#Q1. which is the costliest flat in the dataset?
costliest_flat = df.loc[df['price'].idxmax()]
print("Costliest flat in detail:")
print(costliest_flat)


#Q2.Which locality has the highest average price?
locality_avg_price = df.groupby('locality')['price'].mean()
print(locality_avg_price)


#Q3: Which locality has the highest rate per square foot?
locality_highest_rate = df.groupby('locality')['rate_per_sqft'].mean().idxmax()

print(f"Locality with the highest rate per square foot: {locality_highest_rate}")

# Q4. Do ready-to-move properties cost more than under-construction properties?

ready_to_move = df[df['status'] == 'ready to move']
under_construction = df[df['status'] == 'under construction']

print(f"Average price of ready-to-move properties: {ready_to_move['price'].mean()}")
print(f"Average price of under-construction properties: {under_construction['price'].mean()}")

# Q5. Do RERA-approved properties command a price premium?
rera_approved = df[df['rera_approval'] == 'yes']
non_rera_approved = df[df['rera_approval'] == 'no']

(f"Average price of RERA-approved properties: {rera_approved['price'].mean()}")
(f"Average price of non-RERA-approved properties: {non_rera_approved['price'].mean()}")
if rera_approved['price'].mean() > non_rera_approved['price'].mean():
    print("RERA-approved properties command a price premium.")
else:
    print("RERA-approved properties do not command a price premium.")

# Q6. How does area (sqft) impact property price?
sns.scatterplot(x='area', y='price', data=df)
plt.title('Area vs Price')
plt.xlabel('Area (sqft)')
plt.ylabel('Price')
plt.show()

# Q7. Which property type (Apartment, Floor, Plot) is the costliest?
df.groupby('property_type')['price'].mean().idxmax()
print(f"Costliest property type: {df.groupby('property_type')['price'].mean().idxmax()}")


#Q8. Do certain builders or companies consistently price higher?
df.groupby('company_name')['rate_per_sqft'].mean().idxmax()
print(f"Company with the highest average rate per square foot: {df.groupby('company_name')['rate_per_sqft'].mean().idxmax()}")


#Q9.top 5 builders with the highest average price per sqft
top_5_builders = df.groupby('company_name')['rate_per_sqft'].mean().nlargest(5)
print("Top 5 builders with the highest average price per sqft:")
print(top_5_builders)

#10. are larger homes more expensive on a per-square-foot basis?
sns.scatterplot(x='area', y='rate_per_sqft', data=df)
plt.title('Area vs Rate per Square Foot')
plt.xlabel('Area (sqft)')
plt.ylabel('Rate per Square Foot')
plt.show()